  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ketika kebakaran besar menghabiskan Hutan Arunika, seorang pemuda datang
    ke desa yang tinggal abu\u2014bukan sebagai tentara, melainkan sebagai relawan
    terakhir.\nIa memadamkan bara yang masih menyala, menanam bibit asli di tanah
    yang hangus, membersihkan sungai yang tersumbat, dan mengembalikan tempat berlindung
    bagi satwa. Lima bab perjalanan, satu janji: bahwa dari abu, kehidupan bisa tumbuh
    lagi."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: da7a41fec6dbf3cd4b94c255f67e32e7, type: 2}
