# Unity-generated folders (never commit the imported cache).
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Aa]rtifacts/
/[Rr]ecordings/
/.vs/
/.idea/
/.vscode/
/.plastic/

# Generated IDE/build files.
*.csproj
*.sln
*.slnx
*.user
*.pidb
*.pdb
*.mdb
*.booproj
*.unityproj
*.tmp
*.log
sysinfo.txt
crashlytics-build.properties

# Local credentials and machine-specific environment.
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Keep Unity asset metadata: it preserves scene/prefab references.
!/[Aa]ssets/**/*.meta

# Local backups, screenshots, and OpenCode configuration
/Backups/
/Screenshots/
/opencode.json
# Unity crash artifacts
mono_crash.*.blob
/[Aa]ssets/_Recovery/

# Third-party UI kit — imported locally, never committed to this public repo.
/Assets/ThirdParty/FantasticUI/
/Assets/ThirdParty/FantasticUI.meta
/Assets/ThirdParty.meta
# Role-to-sprite mapping generated from the local kit (run RIMBARA/UI/Build Fantastic theme).
/Assets/UI/FantasticUiKit.asset
/Assets/UI/FantasticUiKit.asset.meta
